# =============================================================================
# Sindh University Dormitory Portal — Environment Configuration Template
# =============================================================================
# Copy this file and rename to: appsettings.Development.json (for .NET backend)
# OR set these as real environment variables in your CI/CD / hosting platform.
#
# NEVER commit actual credentials. This file (.env.example) is safe to commit.
# =============================================================================

# ---------- MySQL Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sindh_dormitory_portal
DB_USER=root
DB_PASSWORD=your_mysql_password

# Full connection string (alternative to individual vars above):
# ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=sindh_dormitory_portal;Uid=root;Pwd=your_mysql_password;

# ---------- JWT Authentication ----------
JWT__SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT__ISSUER=SindhDormitoryPortal
JWT__AUDIENCE=SindhDormitoryPortal
JWT__EXPIRY_MINUTES=60
JWT__REFRESH_TOKEN_EXPIRY_DAYS=7

# ---------- Email (SMTP) ----------
EMAIL__HOST=smtp.gmail.com
EMAIL__PORT=587
EMAIL__USERNAME=your_email@gmail.com
EMAIL__PASSWORD=your_email_app_password
EMAIL__FROM=noreply@sindhdormitory.edu.pk
EMAIL__FROM_NAME=Sindh Dormitory Portal

# ---------- Application ----------
APP__BASE_URL=http://localhost:5000
APP__FRONTEND_URL=http://localhost:4200
APP__ENVIRONMENT=Development

# ---------- File Storage ----------
STORAGE__UPLOAD_PATH=uploads/
STORAGE__MAX_FILE_SIZE_MB=5
STORAGE__ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf
