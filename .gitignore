# ============================================================
# Sindh University Dormitory Portal — .gitignore
# ============================================================

# ---------- Secrets & Credentials (NEVER commit these) ----------
appsettings.Development.json
appsettings.*.json
!appsettings.json
.env
.env.local
.env.*.local

# ---------- Angular / Node ----------
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.sass-cache/
frontend/coverage/
frontend/.nyc_output

# ---------- .NET / C# ----------
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/**/.vs/
backend/**/TestResults/
*.nupkg
*.snupkg

# ---------- EF Core ----------
# Keep migration C# files but ignore auto-generated SQL exports if placed in /obj
backend/**/obj/

# ---------- IDE ----------
.vs/
.vscode/
*.idea/
*.DS_Store
Thumbs.db

# ---------- OS ----------
desktop.ini
.directory

# ---------- Build artifacts ----------
*.log
*.tmp
*.swp
